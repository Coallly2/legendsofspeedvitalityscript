-- ==================== KEY SYSTEM ====================

local function getKeyFilePath()
    return "VitalityScripts_KeyData_" .. tostring(LocalPlayer.UserId)
end

local function saveKeyData(key, timestamp)
    local data = {
        key = key,
        timestamp = timestamp
    }
    local success, err = pcall(function()
        writefile(getKeyFilePath() .. ".json", HttpService:JSONEncode(data))
    end)
    return success
end

local function loadKeyData()
    local success, result = pcall(function()
        local content = readfile(getKeyFilePath() .. ".json")
        return HttpService:JSONDecode(content)
    end)
    if success and result then
        return result
    end
    return nil
end

local function isKeyValid()
    local data = loadKeyData()
    if not data then return false end
    
    if data.key ~= VALID_KEY then
        return false
    end
    
    local currentTime = os.time()
    local elapsedHours = (currentTime - data.timestamp) / 3600
    
    if elapsedHours >= KEY_DURATION_HOURS then
        pcall(function()
            delfile(getKeyFilePath() .. ".json")
        end)
        return false
    end
    
    return true
end

local function validateKey(inputKey)
    if inputKey == VALID_KEY then
        saveKeyData(inputKey, os.time())
        return true
    end
    return false
end

