	local function parseAbbreviatedNumber(text)
		local raw = text:match("^([%d%.]+%a*)") or ""
		local num = tonumber(raw:match("^([%d%.]+)")) or 0
		local suffix = raw:match("(%a+)$")
		if suffix then
			suffix = suffix:upper()
			if suffix == "K" then
				num = num * 1000
			elseif suffix == "M" then
				num = num * 1000000
			elseif suffix == "B" then
				num = num * 1000000000
			elseif suffix == "T" then
				num = num * 1000000000000
			end
		end
		return num
	end

