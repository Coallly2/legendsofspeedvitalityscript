local function doLaunch(customKey, isAutoCheck)
	local enteredKey = (customKey or keyBox.Text):gsub("^%s+", ""):gsub("%s+$", "")
	if enteredKey == "" then
		if not isAutoCheck then
			keyBox:CaptureFocus()
			setStatus("Enter your key first.", Color3.fromRGB(255, 170, 170))
		end
		return
	end

	checkingToken += 1
	local myToken = checkingToken
	local checkStart = os.clock()

	keyBox.Text = enteredKey
	setStatus("")
	setKeyInfo("")
	setLoadingText(isAutoCheck and "Checking saved key" or "Please wait, account verification")
	showPage(loadingPage, "left")
	startLoadingAnimation()

	task.spawn(function()
		local elapsed = os.clock() - checkStart
		if elapsed < 1.5 then
			task.wait(1.5 - elapsed)
		end

		if myToken ~= checkingToken then
			return
		end

		if enteredKey == CORRECT_KEY then
			setKeyInfo("Expires: Lifetime")
			saveKey(enteredKey)
			finishLaunch()
		else
			if isAutoCheck then
				clearSavedKey()
				keyBox.Text = ""
				goBackToRedeemWithMessage("Saved key invalid. Please enter your key again.", Color3.fromRGB(255, 170, 170))
			else
				goBackToRedeemWithMessage("Incorrect key! Get the valid key in our Discord.", Color3.fromRGB(255, 170, 170))
			end
		end
	end)
end

